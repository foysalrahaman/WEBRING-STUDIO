// ═══════════════════════════════════════════════════════════════
// WEBRING — Firebase Storage Security Rules
// ═══════════════════════════════════════════════════════════════
// Images are world-readable (the website displays them).
// Uploads require a signed-in admin and are capped at 15 MB,
// images only.
// Deploy: Firebase Console → Storage → Rules → paste → Publish.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
